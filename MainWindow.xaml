<Window x:Class="ToConvert.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FreeGameX Converter"
        Icon="image.png"
        Width="1120" Height="760" MinWidth="940" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FC" FlowDirection="LeftToRight"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#17223B"/>
        <SolidColorBrush x:Key="Muted" Color="#78849B"/>
        <SolidColorBrush x:Key="Accent" Color="#6558F5"/>
        <DropShadowEffect x:Key="CardShadow" Color="#17223B" BlurRadius="20"
                          ShadowDepth="3" Opacity="0.07"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E7EAF3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>
        <Style x:Key="StudioButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#8B80FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FormatCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="#E2E7F0"/>
            <Setter Property="Background" Value="#FAFBFD"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="294"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <Grid Margin="40,34,40,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,26">
                    <TextBlock x:Name="WelcomeTitle" Text="Welcome to FreeGameX." FontSize="29" FontWeight="Bold"
                               Foreground="{StaticResource Ink}"/>
                    <TextBlock x:Name="WelcomeSubtitle" Text="Drop in a file and find a format that works for you."
                               Margin="0,7,0,0" FontSize="14" Foreground="{StaticResource Muted}"/>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="170"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Choose a file" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="Browse your computer or drag and drop a file below."
                                       Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                        <Border x:Name="DropZone" Grid.Row="1" AllowDrop="True"
                                Background="#F8F8FF" BorderBrush="#CFCBFF" BorderThickness="1.5"
                                CornerRadius="14" DragOver="DropZone_DragOver"
                                DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave"
                                Drop="DropZone_Drop">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="48" Height="48" CornerRadius="15" Background="#EFEEFF"
                                        HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock Text="↑" FontSize="25" Foreground="#6558F5"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Drop files here" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}" HorizontalAlignment="Center"/>
                                <TextBlock Text="or" FontSize="12" Foreground="{StaticResource Muted}"
                                           HorizontalAlignment="Center" Margin="0,3"/>
                                <Button Content="Browse files" Click="Browse_Click"
                                        Style="{StaticResource StudioButton}"
                                        Padding="15,7" Background="White" Foreground="#6558F5"
                                        BorderBrush="#E0DEFF" BorderThickness="1" Cursor="Hand"
                                        FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="SelectedFileCard" Grid.Row="2" Visibility="Collapsed"
                                Background="#F5FAF8" BorderBrush="#DDEFE8" BorderThickness="1"
                                CornerRadius="12" Padding="13" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" Background="#E5F6F0" CornerRadius="10">
                                    <TextBlock Text="✓" Foreground="#249879" FontSize="17"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="FileNameText" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="FileDetailsText" FontSize="11"
                                               Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button x:Name="CreateZipButton" Grid.Column="2" Content="Create ZIP"
                                        Click="CreateZip_Click" Visibility="Collapsed"
                                        Style="{StaticResource StudioButton}"
                                        Background="#EFEEFF" BorderThickness="0" Foreground="#6558F5"
                                        Cursor="Hand" VerticalAlignment="Center" FontSize="10"
                                        Padding="7,6" Margin="4,0"/>
                                <Button x:Name="ExtractZipButton" Grid.Column="3" Content="Extract ZIP"
                                        Click="ExtractZip_Click" Visibility="Collapsed"
                                        Style="{StaticResource StudioButton}"
                                        Background="#E5F6F0" BorderThickness="0" Foreground="#24866E"
                                        Cursor="Hand" VerticalAlignment="Center" FontSize="10"
                                        Padding="7,6" Margin="4,0"/>
                                <Button Grid.Column="4" Content="Remove" Click="RemoveFile_Click"
                                        Style="{StaticResource StudioButton}"
                                        Background="Transparent" BorderThickness="0" Foreground="#D05A68"
                                        Cursor="Hand" VerticalAlignment="Center" FontSize="10"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Original format" FontSize="12" Foreground="{StaticResource Muted}"
                                       Margin="0,0,0,10"/>
                            <ComboBox x:Name="SourceFormatCombo" Style="{StaticResource FormatCombo}"
                                      IsEnabled="False"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18"
                                Background="#F0EFFF" VerticalAlignment="Bottom" Margin="10,0,10,6">
                            <TextBlock Text="⇄" FontSize="19" Foreground="#6558F5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Convert to" FontSize="12" Foreground="{StaticResource Muted}"
                                       Margin="0,0,0,10"/>
                            <ComboBox x:Name="TargetFormatCombo" Style="{StaticResource FormatCombo}"
                                      DisplayMemberPath="Label" SelectedValuePath="Extension"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3">
                    <Button x:Name="ConvertButton" Content="Convert file   →" Height="54"
                            Background="#6558F5" Foreground="White" BorderThickness="0"
                            FontSize="15" FontWeight="Bold" Cursor="Hand" Click="Convert_Click"
                            IsEnabled="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ConvertChrome" Background="{TemplateBinding Background}"
                                        CornerRadius="14">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ConvertChrome" Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ConvertChrome" Property="Opacity" Value="0.78"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="ConvertChrome" Property="Opacity" Value="0.58"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <ProgressBar x:Name="BatchProgressBar" Height="5" Minimum="0" Maximum="1"
                                 Visibility="Collapsed" Margin="0,10,0,0"
                                 Foreground="#6558F5" Background="#E7EAF3"/>
                    <TextBlock x:Name="StatusText" Text="Choose a file to get started."
                               Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource Muted}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Column="1" Background="#192440">
            <Grid Margin="22,24,22,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="image.png" Width="50" Height="44" Stretch="Uniform"/>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="FREEGAMEX" FontSize="16" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="CONVERTER STUDIO" FontSize="9" Foreground="#AAB4C9"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Color" Click="ChangeBackground_Click"
                            Style="{StaticResource StudioButton}"
                            Margin="8,0,0,0" Padding="10,7" VerticalAlignment="Center"
                            Background="#303D5C" Foreground="White" BorderThickness="0"
                            FontSize="10" Cursor="Hand" ToolTip="Change the app background"/>
                </Grid>

                <Border Grid.Row="1" Background="#222F4F" CornerRadius="15" Padding="14" Margin="0,22,0,0">
                    <StackPanel>
                        <TextBlock Text="MUSIC PLAYER" FontSize="10" FontWeight="Bold"
                                   Foreground="#AAB4C9" Margin="0,0,0,8"/>
                        <TextBlock x:Name="MusicPlayerStatus" Text="Ready to play"
                                   FontSize="12" FontWeight="SemiBold" Foreground="White"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="MusicPlayerButton" Grid.Column="0" Content="▶  Play"
                                    Click="MusicToggle_Click" Padding="8,7" Margin="0,0,5,0"
                                    Style="{StaticResource StudioButton}"
                                    Background="#6558F5" Foreground="White" BorderThickness="0"
                                    FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                            <Button Grid.Column="1" Content="■  Stop" Click="MusicStop_Click"
                                    Style="{StaticResource StudioButton}"
                                    Padding="8,7" Margin="3,0" Background="#303D5C"
                                    Foreground="White" BorderThickness="0" FontSize="11" Cursor="Hand"/>
                            <Button Grid.Column="2" Content="Choose" Click="ChooseMusic_Click"
                                    Style="{StaticResource StudioButton}"
                                    Padding="8,7" Margin="5,0,0,0" Background="#303D5C"
                                    Foreground="White" BorderThickness="0" FontSize="11" Cursor="Hand"/>
                        </Grid>
                        <DockPanel Margin="0,11,0,0">
                            <TextBlock Text="Volume" FontSize="10" Foreground="#AAB4C9"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider x:Name="MusicVolumeSlider" Minimum="0" Maximum="1" Value="0.5"
                                    ValueChanged="MusicVolumeSlider_ValueChanged"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,22,0,16">
                        <TextBlock Text="Convert with confidence." FontSize="20" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Your files stay on your device. Nothing is uploaded."
                                   TextWrapping="Wrap" FontSize="11" LineHeight="18" Foreground="#AAB4C9"
                                   Margin="0,8,0,0"/>

                        <Border Background="#222F4F" CornerRadius="15" Padding="14" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="SUPPORTED FORMATS" FontSize="10" FontWeight="Bold"
                                           Foreground="#AAB4C9" Margin="0,0,0,11"/>
                                <TextBlock Text="AUDIO &amp; VIDEO" FontSize="9" Foreground="#AAB4C9"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="MP3 · WAV · AAC · FLAC · OGG · Opus&#10;MP4 · MKV · MOV · WebM · AVI · WMV"
                                           FontSize="11" Foreground="White" TextWrapping="Wrap"/>
                                <Border Height="1" Background="#36415E" Margin="0,10"/>
                                <TextBlock Text="IMAGES" FontSize="9" Foreground="#AAB4C9"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="PNG · JPG · ICO · BMP · GIF · TIFF · WebP · AVIF&#10;JPEG 2000 · TGA · PCX · DDS · PPM"
                                           FontSize="11" Foreground="White" TextWrapping="Wrap"/>
                                <Border Height="1" Background="#36415E" Margin="0,10"/>
                                <TextBlock Text="DATA, TEXT &amp; ARCHIVES" FontSize="9" Foreground="#AAB4C9"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="JSON · XML · CSV · TXT · Markdown · HTML · DOCX · ZIP · TAR · GZ"
                                           FontSize="11" Foreground="White" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="3">
                    <Border Height="1" Background="#36415E" Margin="0,0,0,12"/>
                    <Border Background="#222F4F" BorderBrush="#35415F" BorderThickness="1"
                            CornerRadius="14" Padding="12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" Background="#34315F" CornerRadius="10">
                                    <TextBlock Text="↻" FontSize="19" Foreground="#AFA7FF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="APP UPDATES" FontSize="10" FontWeight="Bold"
                                               Foreground="White"/>
                                    <TextBlock x:Name="VersionText" Text="Version 1.2.0"
                                               FontSize="9" Foreground="#AAB4C9" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="#193D39" CornerRadius="7"
                                        Padding="7,4" VerticalAlignment="Center">
                                    <TextBlock Text="AUTO" FontSize="8" FontWeight="Bold"
                                               Foreground="#83D9C1"/>
                                </Border>
                            </Grid>
                            <Border Background="#1B2743" CornerRadius="8" Padding="8"
                                    Margin="0,10,0,9">
                                <TextBlock x:Name="UpdateStatusText"
                                           Text="Checks automatically when the app opens."
                                           TextWrapping="Wrap" FontSize="9" Foreground="#C1C9DA"/>
                            </Border>
                            <Button x:Name="CheckUpdatesButton" Content="Check for updates  →"
                                    Click="CheckForUpdates_Click" Height="34"
                                    Style="{StaticResource StudioButton}"
                                    Background="#6558F5" Foreground="White" BorderThickness="0"
                                    FontSize="10" FontWeight="SemiBold" Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="FFmpeg is LGPL-2.1-or-later; protected formats may need extra tools."
                               TextWrapping="Wrap" FontSize="8" LineHeight="13"
                               Foreground="#8793AC" Margin="0,9,0,0"/>
                    <Button Content="View FFmpeg license" Click="ViewLicense_Click"
                            HorizontalAlignment="Left" Padding="0,4" Margin="0,2,0,0"
                            Style="{StaticResource StudioButton}"
                            Background="Transparent" BorderThickness="0" Foreground="#AAB4C9"
                            FontSize="9" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
