<Window x:Class="ToConvert.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Starting FreeGameX"
        Width="460" Height="300"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#192440" FontFamily="Segoe UI">
    <Border BorderBrush="#35405D" BorderThickness="1" CornerRadius="22" Padding="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="image.png" Width="116" Height="94" Stretch="Uniform"
                       HorizontalAlignment="Center"/>
                <TextBlock Text="FREEGAMEX" FontSize="23" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                <TextBlock Text="CONVERTER STUDIO" FontSize="10"
                           Foreground="#AAB4C9" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
            <ProgressBar Grid.Row="1" Height="4" IsIndeterminate="True"
                         Background="#303D5C" Foreground="#8B80FF" BorderThickness="0"/>
            <TextBlock Grid.Row="2" Text="Preparing your workspace..."
                       FontSize="11" Foreground="#AAB4C9" HorizontalAlignment="Center"
                       Margin="0,14,0,0"/>
        </Grid>
    </Border>
</Window>
